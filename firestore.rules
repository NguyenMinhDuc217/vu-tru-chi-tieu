rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Vũ Trụ Chi Tiêu: each signed-in user owns everything under vutru_chitieu/<their uid>/.
    // This project (python-chat-7e32a) is shared with another app: keep that app's own
    // match blocks next to this one instead of replacing them.
    match /vutru_chitieu/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
